#!/usr/bin/env bash
#
# Ponto de entrada unico. Carrega as imagens do repo e sobe o Overleaf.
#
#   ./dev              sobe e fica neste terminal (Ctrl+C para). Ou: npm start
#   ./dev up -d        sobe em background
#   ./dev stop         para os containers
#   ./dev restart      para e sobe de novo
#   ./dev logs         segue os logs
#   ./dev shell        shell dentro do container do Overleaf
#   ./dev mongo        shell do MongoDB
#   ./dev doctor       diagnostico do deploy
#   ./dev pack         congela as imagens Docker em vendor/images/ (uma vez)
#   ./dev status       o que esta rodando
#   ./dev projects     seed | export | watch da pasta projects/

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_DIR="$REPO_ROOT/toolkit"
CONTAINER="sharelatex"

die() { echo "erro: $*" >&2; exit 1; }

# shellcheck source=scripts/images.sh
source "$REPO_ROOT/scripts/images.sh"

ensure_bootstrap() {
  if [ ! -e "$REPO_ROOT/config/overleaf.rc" ] || [ ! -L "$TOOLKIT_DIR/config" ]; then
    echo "==> Primeira execucao, rodando bootstrap"
    "$REPO_ROOT/bootstrap.sh"
  fi
}

tk() {
  local cmd="$1"; shift
  ensure_bootstrap
  ( cd "$TOOLKIT_DIR" && "./bin/$cmd" "$@" )
}

REPLICA_PID="$REPO_ROOT/toolkit/data/projects-replica.pid"

stop_replica_watcher() {
  if [ -f "$REPLICA_PID" ]; then
    local pid
    pid="$(cat "$REPLICA_PID" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$REPLICA_PID"
  fi
}

start_replica_watcher() {
  stop_replica_watcher
  mkdir -p "$REPO_ROOT/toolkit/data"
  python3 "$REPO_ROOT/scripts/projects_replica.py" watch \
    >> "$REPO_ROOT/toolkit/data/projects-replica.log" 2>&1 &
  echo $! > "$REPLICA_PID"
}

sync_projects() {
  stop_replica_watcher
  python3 "$REPO_ROOT/scripts/projects_replica.py" seed
  start_replica_watcher
}

cmd_up() {
  ensure_bootstrap
  ensure_images
  local arg detach=0
  for arg in "$@"; do
    if [ "$arg" = "-d" ] || [ "$arg" = "--detach" ]; then
      detach=1
    fi
  done
  if [ "$detach" -eq 1 ]; then
    tk up "$@"
    echo
    echo "Overleaf no ar: http://localhost/launchpad"
    echo "Para ver logs:  npm run logs   ou   ./dev logs"
    echo "Para parar:    npm stop        ou   ./dev stop"
    sync_projects
    return 0
  fi

  trap 'echo; stop_replica_watcher; tk stop; exit 0' INT TERM
  tk up -d "$@"
  sync_projects
  echo
  echo "Overleaf no ar: http://localhost/launchpad"
  echo "Ctrl+C para o projeto."
  tk logs -f
}

case "${1:-up}" in
  up)            shift || true; cmd_up "$@" ;;
  stop)          shift || true; stop_replica_watcher; tk stop "$@" ;;
  restart)       stop_replica_watcher; tk stop; cmd_up -d ;;
  logs)          shift || true; tk logs -f "$@" ;;
  shell)         tk shell ;;
  mongo)         tk mongo ;;
  doctor)        tk doctor ;;
  pack)          cmd_pack ;;
  status)        ensure_bootstrap; ( cd "$TOOLKIT_DIR" && ./bin/docker compose ps ) ;;
  projects)      shift || true; python3 "$REPO_ROOT/scripts/projects_replica.py" "$@" ;;
  -h|--help|help) awk 'NR>2 && /^#/ {sub(/^# ?/,""); print; next} NR>2 {exit}' "$0" ;;
  *)             die "subcomando desconhecido: $1  (veja './dev help')" ;;
esac
