#!/usr/bin/env bash
#
# Ponto de entrada unico. Carrega as imagens do repo e sobe o Overleaf.
#
#   ./dev              sobe em background (ou: npm start)
#   ./dev up -d        idem
#   ./dev stop         para os containers
#   ./dev restart      para e sobe de novo
#   ./dev logs         segue os logs
#   ./dev shell        shell dentro do container do Overleaf
#   ./dev mongo        shell do MongoDB
#   ./dev doctor       diagnostico do deploy
#   ./dev pack         congela as imagens Docker em vendor/images/ (uma vez)
#   ./dev status       o que esta rodando

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_DIR="$REPO_ROOT/toolkit"
CONTAINER="sharelatex"

die() { echo "erro: $*" >&2; exit 1; }

# shellcheck source=scripts/images.sh
source "$REPO_ROOT/scripts/images.sh"

ensure_bootstrap() {
  if [ ! -e "$REPO_ROOT/config/overleaf.rc" ] || [ ! -L "$TOOLKIT_DIR/config" ]; then
    echo "==> Primeira execucao, rodando bootstrap"
    "$REPO_ROOT/bootstrap.sh"
  fi
}

tk() {
  local cmd="$1"; shift
  ensure_bootstrap
  ( cd "$TOOLKIT_DIR" && "./bin/$cmd" "$@" )
}

cmd_up() {
  ensure_bootstrap
  ensure_images
  if [ "$#" -eq 0 ]; then
    set -- -d
  fi
  tk up "$@"
  local arg
  for arg in "$@"; do
    if [ "$arg" = "-d" ] || [ "$arg" = "--detach" ]; then
      echo
      echo "Overleaf no ar: http://localhost/launchpad"
      echo "Para ver logs:  npm run logs   ou   ./dev logs"
      return 0
    fi
  done
}

case "${1:-up}" in
  up)            shift || true; cmd_up "$@" ;;
  stop)          shift || true; tk stop "$@" ;;
  restart)       tk stop; cmd_up -d ;;
  logs)          shift || true; tk logs -f "$@" ;;
  shell)         tk shell ;;
  mongo)         tk mongo ;;
  doctor)        tk doctor ;;
  pack)          cmd_pack ;;
  status)        ensure_bootstrap; ( cd "$TOOLKIT_DIR" && ./bin/docker compose ps ) ;;
  -h|--help|help) awk 'NR>2 && /^#/ {sub(/^# ?/,""); print; next} NR>2 {exit}' "$0" ;;
  *)             die "subcomando desconhecido: $1  (veja './dev help')" ;;
esac
